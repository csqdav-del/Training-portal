# Firebase Configuration
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Strava API (optional for local dev)
VITE_STRAVA_CLIENT_ID=YOUR_STRAVA_CLIENT_ID
VITE_STRAVA_CLIENT_SECRET=YOUR_STRAVA_CLIENT_SECRET

# Origine des fonctions serverless.
# Laisser vide pour le web (les URLs relatives suffisent).
# OBLIGATOIRE pour le build Android : la WebView sert capacitor://localhost,
# donc "/.netlify/functions/..." ne pointerait pas vers Netlify.
# Ex. : https://training-portal-david.netlify.app
VITE_API_BASE=
