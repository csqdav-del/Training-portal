rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Le client ne doit jamais pouvoir écrire stravaConnected/lastStravaSync* lui-même —
      // ces champs sont gérés uniquement par les fonctions serverless (Admin SDK, qui ignore ces règles).
      allow write: if false;

      match /workouts/{workoutId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        // Écriture Strava = fonction serverless (Admin SDK, ignore ces règles).
        // Écriture client = uniquement des entrées manuelles (id préfixé "manual_").
        allow write: if request.auth != null && request.auth.uid == uid && workoutId.matches('manual_.*');
      }

      match /scheduleOverrides/{weekId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /nutritionLogs/{dateId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Relevés de poids saisis dans l'app (un doc par jour, id = YYYY-MM-DD).
      match /weights/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Préférences persistées (date d'arrêt de la vapoteuse, etc.).
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /private/{docId} {
        allow read, write: if false; // jamais accessible côté client — Admin SDK seulement
      }
    }
  }
}
